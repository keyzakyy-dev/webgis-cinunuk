RewriteEngine On

# ── Izinkan akses langsung ke admin/ dan tools/ ─────────────────────
RewriteCond %{REQUEST_URI} ^/gis/backend/admin/ [OR]
RewriteCond %{REQUEST_URI} ^/gis/backend/tools/ [OR]
RewriteCond %{REQUEST_URI} ^/gis/backend/public/uploads/
RewriteRule ^ - [L]

# ── API routes: /gis/backend/api/* → public/index.php ───────────────
RewriteCond %{REQUEST_URI} ^/gis/backend/api/(.*)$
RewriteRule ^api/(.*)$ public/index.php [QSA,L]

# ── Default: arahkan ke public/ ──────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/$1 [L]